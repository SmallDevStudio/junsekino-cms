rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * Junsekino CMS currently performs
     * database operations through the
     * Firebase Admin SDK on the server.
     *
     * Client-side Firestore access is
     * denied by default.
     */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}